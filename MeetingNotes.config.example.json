{
  "_comment": "Example configuration. Copy this file to 'MeetingNotes.config.json' and adjust it. The real file sits next to the EXE (release) or in the repository root (dev) and is listed in .gitignore. Source: src/shared/config-contract.ts -> AppConfig.",

  "azure": {
    "model": "standard",
    "endpoint": "wss://westeurope.stt.speech.microsoft.com/speech/universal/v2",
    "batchEndpoint": "",
    "region": "westeurope",
    "speechKey": "<YOUR-AZURE-SPEECH-KEY-HERE>",
    "interimResults": true,
    "proxy": {
      "host": "",
      "port": 0,
      "username": "",
      "password": ""
    }
  },

  "user": {
    "language": "de-DE",
    "fileTranscription": {
      "model": "standard",
      "language": "de-DE",
      "autoLanguageDetection": true,
      "diarization": true
    },
    "transcription": {
      "mic": true,
      "speaker": true,
      "audioMode": "dual-mono"
    },
    "autoLanguageDetection": true,
    "diarization": true,
    "devices": {
      "micId": null,
      "speakerLoopbackId": null
    },
    "transcript": {
      "markdownExport": {
        "enabled": true,
        "path": null
      }
    },
    "autoStart": {
      "enabled": true,
      "autoStop": true,
      "stopOnSilence": false,
      "silenceMinutes": 5,
      "processes": []
    },
    "window": {
      "minimizeToTrayOnClose": true,
      "hideFromTaskbar": true
    }
  }
}
