{
  "name": "meeting-notes",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Meeting Notes (Windows-Desktop-App fuer Meeting-Transkripte)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "build:sidecar": "dotnet build sidecar/MeetingNotes.Sidecar.csproj -c Release -r win-x64 --artifacts-path src-tauri/target/sidecar-artifacts",
    "test:sidecar": "dotnet run --project sidecar/Validation/MeetingNotes.Sidecar.Validation.csproj -c Release --artifacts-path src-tauri/target/sidecar-validation-artifacts",
    "clean:sidecar": "node scripts/clean-sidecar.mjs",
    "publish:sidecar": "dotnet publish sidecar/MeetingNotes.Sidecar.csproj -c Release -r win-x64 --self-contained true -f net10.0-windows --artifacts-path src-tauri/target/sidecar-artifacts -o src-tauri/target/sidecar-publish",
    "test:sidecar:published": "dotnet run --project sidecar/Validation/MeetingNotes.Sidecar.Validation.csproj -c Release --artifacts-path src-tauri/target/sidecar-validation-artifacts -- --sidecar-exe src-tauri/target/sidecar-publish/MeetingNotes.Sidecar.exe",
    "dist:portable": "node scripts/dist-portable.mjs",
    "test:smoke": "node scripts/test-smoke.mjs",
    "measure:latency": "node scripts/measure-latency-tauri.mjs",
    "docs:specs": "node scripts/update-spec-overview.mjs",
    "check:specs": "node scripts/check-spec-consistency.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:deployment": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-deployment.ps1 -PortableDir dist/portable",
    "test:unit": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
