{
  "name": "meeting-notes",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Meeting Notes (Windows-Desktop-App fuer Meeting-Transkripte)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "build:sidecar": "dotnet build sidecar/MeetingNotes.Sidecar.csproj -c Release",
    "clean:sidecar": "node scripts/clean-sidecar.mjs",
    "publish:sidecar": "npm run clean:sidecar && dotnet publish sidecar/MeetingNotes.Sidecar.csproj -c Release -r win-x64 --self-contained false -o sidecar/publish/sidecar",
    "dist:portable": "node scripts/dist-portable.mjs",
    "test:smoke": "node scripts/test-smoke.mjs",
    "test:unit": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
