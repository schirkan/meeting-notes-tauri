<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MeetingNotes.Sidecar</RootNamespace>
    <AssemblyName>MeetingNotes.Sidecar</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Validation\**\*.cs" />
    <InternalsVisibleTo Include="MeetingNotes.Sidecar.Validation" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.53.0" />
  </ItemGroup>
</Project>
