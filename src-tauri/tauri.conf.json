{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "meeting-notes",
  "mainBinaryName": "MeetingNotes",
  "version": "0.1.9",
  "identifier": "de.schirkan.meeting-notes",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "windows": [
      {
        "title": "Meeting Notes",
        "width": 950,
        "height": 800,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,msSpeechRecognitionServiceUseCetoService --autoplay-policy=no-user-gesture-required",
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "target/sidecar-publish/MeetingNotes.Sidecar.exe": "MeetingNotes.Sidecar.exe"
    }
  },
  "plugins": {
    "shell": {
      "open": false
    }
  }
}
